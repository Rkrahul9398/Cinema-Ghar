<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cinema Ghar</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #42a354; color: whitesmoke; }
        .container { max-width: 1200px; margin: 0 auto; }
        .editor-panel { display: flex; gap: 20px; margin-top: 20px; }
        .video-container { flex: 2; position: relative; }
        .controls { flex: 1; background: #2c2c2c; padding: 20px; border-radius: 10px; }
        .timeline { height: 100px; background: #444; margin-top: 20px; border-radius: 5px; }
        input[type="range"] { width: 100%; }
        .filter-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .filter-item { padding: 10px; border: 1px solid #666; cursor: pointer; text-align: center; background: #333; border-radius: 5px; color: white; }
        .filter-item:hover { background: #555; }
        iframe, video { width: 100%; height: 360px; border-radius: 10px; }
        button { background: #ff5722; color: #fff; border: none; padding: 10px 15px; cursor: pointer; border-radius: 5px; margin-top: 10px; }
        button:hover { background: #1c3f34c7; }
        header { background: blue; padding: 15px; text-align: center; }
        h1 { color: red; }
        footer { background: blue; padding: 10px; text-align: center; color: white; margin-top: 20px; }
    </style>
</head>
<body>
    <header>
        <h1>Take A Short</h1>
    </header>
    <div class="container">
        
        <!-- Source Input -->
        <div class="source-input">
            <input type="text" id="youtubeUrl" placeholder="Enter YouTube URL">
            <button onclick="loadYouTubeVideo()">Load</button>
            <input type="file" id="videoUpload" accept="video/*">
        </div>

        <!-- Editor Interface -->
        <div class="editor-panel">
            <div class="video-container" id="videoContainer">
                <video id="mainVideo" controls></video>
                <div class="timeline" id="timeline"></div>
            </div>
            
            <div class="controls">
                <!-- Trim Controls -->
                <div class="control-group">
                    <h3>Trim Video</h3>
                    <label>Start Time: <input type="range" id="startTime" min="0" max="100" value="0"></label>
                    <label>End Time: <input type="range" id="endTime" min="0" max="100" value="100"></label>
                </div>

                <!-- Filters -->
                <div class="control-group">
                    <h3>Filters</h3>
                    <div class="filter-grid">
                        <div class="filter-item" data-filter="grayscale(100%)">Grayscale</div>
                        <div class="filter-item" data-filter="sepia(100%)">Sepia</div>
                        <div class="filter-item" data-filter="contrast(200%)">Contrast</div>
                    </div>
                </div>

                <!-- Speed Control -->
                <div class="control-group">
                    <h3>Playback Speed</h3>
                    <input type="range" id="playbackSpeed" min="0.5" max="4" step="0.1" value="1">
                </div>

                <!-- Export Options -->
                <button onclick="processVideo()">Export Video</button>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2025 Video Editor Pro. All rights reserved.</p>
    </footer>

    <script>
        const video = document.getElementById('mainVideo');
        const startTime = document.getElementById('startTime');
        const endTime = document.getElementById('endTime');
        const playbackSpeed = document.getElementById('playbackSpeed');
        const filters = document.querySelectorAll('.filter-item');

        // Load YouTube Video
        function loadYouTubeVideo() {
            const url = document.getElementById('youtubeUrl').value;
            const videoId = extractYouTubeId(url);
            if (videoId) {
                document.getElementById('videoContainer').innerHTML = `<iframe src="https://www.youtube.com/embed/${videoId}" frameborder="0" allowfullscreen></iframe>`;
            }
        }

        // File Upload Handler
        document.getElementById('videoUpload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const url = URL.createObjectURL(file);
            video.src = url;
        });

        // Trimming Functionality
        startTime.addEventListener('input', updateTrim);
        endTime.addEventListener('input', updateTrim);
        function updateTrim() {
            video.currentTime = startTime.value;
            video.ontimeupdate = () => {
                if (video.currentTime >= endTime.value) {
                    video.pause();
                }
            };
        }

        // Speed Control
        playbackSpeed.addEventListener('input', function() {
            video.playbackRate = this.value;
        });

        // Apply Filters
        filters.forEach(filter => {
            filter.addEventListener('click', function() {
                video.style.filter = this.getAttribute('data-filter');
            });
        });

        // Export Video (Using FFmpeg.js placeholder)
        async function processVideo() {
            alert("Exporting video... (Processing will be added later)");
        }

        // YouTube ID extractor
        function extractYouTubeId(url) {
            const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            const match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }
    </script>
</body>
</html>
